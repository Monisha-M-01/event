# FanFlow AI Environment Configuration

# 1. Get a Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. LLM Settings (Defaults usually fine)
LLM_MODEL=gemini-3.1-flash-lite
LLM_MODEL_LITE=gemini-3.1-flash-lite
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3

# 3. Rate limiting (requests/time)
RATE_LIMIT=30/minute
